{% extends 'base.html.twig' %}

{% block title %}
    Contact | Airways Orthodontics
{% endblock %}

{% block meta_description %}
    Neem contact op met Airways Orthodontics in Hengelo. Wij helpen u graag bij vragen over behandelingen, afspraken en verwijzingen.
{% endblock %}

{% block body %}

<section class="bg-[#f4f5f1] py-20 lg:py-28">

    <div class="mx-auto max-w-7xl px-6 lg:px-8">

        <div class="max-w-4xl">

            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-teal-700">
                Contact
            </p>

            <h1 class="mt-5 text-5xl font-semibold tracking-tight text-slate-950 lg:text-6xl">
                Wij helpen u
                <span class="text-teal-700">
                    graag verder.
                </span>
            </h1>

            <p class="mt-8 max-w-3xl text-xl leading-9 text-slate-600">
                Heeft u vragen over een behandeling, wilt u een afspraak maken
                of bent u zorgverlener en wilt u een patiënt verwijzen?
                Neem gerust contact met ons op.
            </p>

        </div>

    </div>

</section>



<section class="bg-white py-24">

    <div class="mx-auto grid max-w-7xl gap-14 px-6 lg:grid-cols-[1.1fr_0.9fr] lg:px-8">

        <div>

            <h2 class="text-3xl font-semibold text-slate-950">
                Contactgegevens
            </h2>

            <div class="mt-10 space-y-8">

                <div>

                    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">
                        Bezoekadres
                    </p>

                    <p class="mt-3 text-lg leading-8 text-slate-600">
                        Antillenstraat 25<br>
                        7556 AV Hengelo
                    </p>

                </div>

                <div>

                    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">
                        Telefoon
                    </p>

                    <p class="mt-3 text-lg">
                        <a
                            href="tel:+31747920080"
                            class="font-medium text-slate-900 hover:text-teal-700"
                        >
                            +31 (0)74 792 00 80
                        </a>
                    </p>

                </div>

                <div>

                    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">
                        E-mail
                    </p>

                    <p class="mt-3 text-lg">
                        <a
                            href="mailto:info@airways-orthodontics.nl"
                            class="font-medium text-slate-900 hover:text-teal-700"
                        >
                            info@airways-orthodontics.nl
                        </a>
                    </p>

                </div>

            </div>

        </div>


        <aside>

            <div class="rounded-3xl bg-[#eef8f7] p-10">

                <h2 class="text-2xl font-semibold text-slate-950">
                    Openingstijden
                </h2>

                <dl class="mt-8 space-y-5">

                    <div class="flex justify-between border-b border-teal-100 pb-3">
                        <dt>Maandag</dt>
                        <dd>08.30 – 17.00</dd>
                    </div>

                    <div class="flex justify-between border-b border-teal-100 pb-3">
                        <dt>Dinsdag</dt>
                        <dd>08.30 – 17.00</dd>
                    </div>

                    <div class="flex justify-between border-b border-teal-100 pb-3">
                        <dt>Woensdag</dt>
                        <dd>08.30 – 17.00</dd>
                    </div>

                    <div class="flex justify-between border-b border-teal-100 pb-3">
                        <dt>Donderdag</dt>
                        <dd>08.30 – 17.00</dd>
                    </div>

                    <div class="flex justify-between">
                        <dt>Vrijdag</dt>
                        <dd>08.30 – 17.00</dd>
                    </div>

                </dl>

                <p class="mt-8 text-sm leading-7 text-slate-600">
                    Behandeling vindt plaats op afspraak.
                </p>

            </div>

        </aside>

    </div>

</section>



<section class="bg-[#f8faf9] py-24">

    <div class="mx-auto max-w-7xl px-6 lg:px-8">

        <div class="grid gap-8 lg:grid-cols-2">

            <article class="rounded-3xl bg-white p-10 shadow-sm ring-1 ring-slate-200">

                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">
                    Voor verwijzers
                </p>

                <h2 class="mt-4 text-3xl font-semibold text-slate-950">
                    Een patiënt verwijzen
                </h2>

                <p class="mt-5 leading-8 text-slate-600">
                    Wilt u een patiënt aanmelden voor een multidisciplinaire
                    beoordeling? Lees hoe een verwijzing verloopt en neem
                    rechtstreeks contact op met ons team.
                </p>

                <a
                    href="{{ path('contact_refer') }}"
                    class="mt-8 inline-flex items-center rounded-full bg-teal-950 px-6 py-3.5 font-semibold text-white transition hover:bg-teal-900"
                >
                    Patiënt verwijzen
                </a>

            </article>



            <article class="rounded-3xl bg-white p-10 shadow-sm ring-1 ring-slate-200">

                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">
                    Samenwerking
                </p>

                <h2 class="mt-4 text-3xl font-semibold text-slate-950">
                    Ons netwerk
                </h2>

                <p class="mt-5 leading-8 text-slate-600">
                    Airways Orthodontics werkt samen met verschillende
                    specialisten op het gebied van orthodontie, airway
                    dentistry, kaakchirurgie, ademtherapie en logopedie.
                </p>

                <a
                    href="{{ path('collaboration_index') }}"
                    class="mt-8 inline-flex items-center rounded-full border border-slate-300 px-6 py-3.5 font-semibold text-slate-900 transition hover:border-slate-400 hover:bg-slate-50"
                >
                    Bekijk samenwerking
                </a>

            </article>

        </div>

    </div>

</section>

{% endblock %}