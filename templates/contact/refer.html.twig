{% extends 'base.html.twig' %}

{% block title %}
    Patiënt verwijzen | Airways Orthodontics
{% endblock %}

{% block meta_description %}
    Verwijs een patiënt naar Airways Orthodontics voor een multidisciplinaire beoordeling van luchtweg-, ademhalings- en slaapgerelateerde klachten.
{% endblock %}

{% block body %}

<section class="bg-[#f4f5f1] py-20 lg:py-28">

    <div class="mx-auto max-w-7xl px-6 lg:px-8">

        <div class="max-w-4xl">

            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-teal-700">
                Patiënt verwijzen
            </p>

            <h1 class="mt-5 text-5xl font-semibold tracking-tight text-slate-950 lg:text-6xl">
                Een patiënt aanmelden
                <span class="text-teal-700">
                    bij Airways Orthodontics.
                </span>
            </h1>

            <p class="mt-8 max-w-3xl text-xl leading-9 text-slate-600">
                U kunt een patiënt telefonisch of per e-mail aanmelden.
                Twijfelt u of een verwijzing passend is? Neem dan gerust eerst
                contact met ons op. We denken graag mee over de meest geschikte
                vervolgstap.
            </p>

        </div>

    </div>

</section>


<section class="bg-white py-20 lg:py-24">

    <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[1fr_0.9fr] lg:px-8">

        <div>

            <h2 class="text-3xl font-semibold text-slate-950">
                Hoe kunt u verwijzen?
            </h2>

            <div class="mt-10 space-y-6">

                <article class="rounded-3xl border border-slate-200 p-7">

                    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">
                        Telefonisch
                    </p>

                    <h3 class="mt-3 text-xl font-semibold text-slate-950">
                        Bespreek de patiënt met ons team
                    </h3>

                    <p class="mt-3 leading-7 text-slate-600">
                        Voor overleg of een eerste beoordeling kunt u ons
                        telefonisch bereiken. We denken graag mee voordat u
                        verwijst.
                    </p>

                    <a
                        href="tel:+31747920080"
                        class="mt-6 inline-flex items-center rounded-full bg-teal-950 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-teal-900"
                    >
                        +31 (0)74 792 00 80
                    </a>

                </article>


                <article class="rounded-3xl border border-slate-200 p-7">

                    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">
                        Per e-mail
                    </p>

                    <h3 class="mt-3 text-xl font-semibold text-slate-950">
                        Stuur uw verwijzing rechtstreeks
                    </h3>

                    <p class="mt-3 leading-7 text-slate-600">
                        Vermeld indien mogelijk de hulpvraag, relevante
                        klachten en uw contactgegevens. Wij nemen vervolgens
                        contact op over het verdere traject.
                    </p>

                    <a
                        href="mailto:verwijzers@airways-orthodontics.nl"
                        class="mt-6 inline-flex items-center rounded-full border border-slate-300 px-6 py-3.5 text-sm font-semibold text-slate-900 transition hover:border-slate-400 hover:bg-slate-50"
                    >
                        verwijzers@airways-orthodontics.nl
                    </a>

                </article>

            </div>

        </div>


        <aside>

            <div class="sticky top-28 rounded-[2rem] bg-teal-950 p-8 text-white lg:p-10">

                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-white/60">
                    Airways Orthodontics
                </p>

                <h2 class="mt-4 text-2xl font-semibold">
                    Contact verwijzers
                </h2>

                <div class="mt-8 space-y-6 text-sm leading-6">

                    <div>
                        <p class="font-semibold text-white">
                            Adres
                        </p>

                        <p class="mt-1 text-white/70">
                            Antillenstraat 25<br>
                            7556 AV Hengelo
                        </p>
                    </div>

                    <div>
                        <p class="font-semibold text-white">
                            Telefoon
                        </p>

                        <a
                            href="tel:+31747920080"
                            class="mt-1 block text-white/70 transition hover:text-white"
                        >
                            +31 (0)74 792 00 80
                        </a>
                    </div>

                    <div>
                        <p class="font-semibold text-white">
                            Verwijzingen
                        </p>

                        <a
                            href="mailto:verwijzers@airways-orthodontics.nl"
                            class="mt-1 block break-all text-white/70 transition hover:text-white"
                        >
                            verwijzers@airways-orthodontics.nl
                        </a>
                    </div>

                    <div>
                        <p class="font-semibold text-white">
                            Algemeen
                        </p>

                        <a
                            href="mailto:info@airways-orthodontics.nl"
                            class="mt-1 block break-all text-white/70 transition hover:text-white"
                        >
                            info@airways-orthodontics.nl
                        </a>
                    </div>

                </div>

            </div>

        </aside>

    </div>

</section>


<section class="bg-[#eef8f7] py-20">

    <div class="mx-auto max-w-7xl px-6 lg:px-8">

        <div class="max-w-3xl">

            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">
                Na de aanmelding
            </p>

            <h2 class="mt-4 text-3xl font-semibold text-slate-950">
                Wat gebeurt er daarna?
            </h2>

        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">

            {% set steps = [
                {
                    number: '01',
                    title: 'Eerste contact',
                    text: 'Wij nemen contact op met de patiënt of verwijzer om de hulpvraag te verduidelijken.'
                },
                {
                    number: '02',
                    title: 'Oriënterend gesprek',
                    text: 'De klachten en medische voorgeschiedenis worden zorgvuldig besproken.'
                },
                {
                    number: '03',
                    title: 'Teambeoordeling',
                    text: 'Indien nodig wordt de patiënt multidisciplinair besproken binnen het netwerk.'
                },
                {
                    number: '04',
                    title: 'Advies',
                    text: 'De patiënt en verwijzer ontvangen duidelijkheid over de mogelijke vervolgstappen en kosten.'
                }
            ] %}

            {% for step in steps %}

                <article class="rounded-3xl bg-white p-7 shadow-sm ring-1 ring-slate-200/70">

                    <p class="text-sm font-semibold text-teal-700">
                        {{ step.number }}
                    </p>

                    <h3 class="mt-4 text-xl font-semibold text-slate-950">
                        {{ step.title }}
                    </h3>

                    <p class="mt-3 text-sm leading-6 text-slate-600">
                        {{ step.text }}
                    </p>

                </article>

            {% endfor %}

        </div>

    </div>

</section>


<section class="bg-white py-20">

    <div class="mx-auto max-w-7xl px-6 lg:px-8">

        <div class="rounded-[2rem] bg-slate-950 px-8 py-10 text-white lg:flex lg:items-center lg:justify-between lg:px-10">

            <div class="max-w-2xl">

                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-300">
                    Nog niet zeker?
                </p>

                <h2 class="mt-3 text-3xl font-semibold">
                    Twijfelt u of een patiënt in aanmerking komt?
                </h2>

                <p class="mt-4 leading-7 text-white/70">
                    Bel of mail ons gerust. We denken graag vrijblijvend mee
                    over de vraag of een multidisciplinaire beoordeling zinvol is.
                </p>

            </div>

            <div class="mt-8 flex flex-wrap gap-3 lg:ml-10 lg:mt-0">

                <a
                    href="tel:+31747920080"
                    class="inline-flex items-center rounded-full bg-white px-6 py-3.5 text-sm font-semibold text-slate-950 transition hover:bg-slate-100"
                >
                    Bel ons
                </a>

                <a
                    href="mailto:verwijzers@airways-orthodontics.nl"
                    class="inline-flex items-center rounded-full border border-white/25 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-white/10"
                >
                    Stuur een e-mail
                </a>

            </div>

        </div>

    </div>

</section>

{% endblock %}