{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    Airways Orthodontics
{% endblock %}

{% block main %}

    <div class="container-fluid">

        <div class="mb-4">
            <h1 class="h3 mb-2">
                Dashboard
            </h1>

            <p class="text-muted mb-0">
                Beheer de kennisbank en inhoud van Airways Orthodontics.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">

                        <h2 class="h5">
                            Kennisbank
                        </h2>

                        <p class="text-muted">
                            Beheer categorieën en artikelen binnen de kennisbank.
                        </p>

                        <a
                            href="#"
                            class="btn btn-primary"
                        >
                            Naar categorieën
                        </a>

                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">

                        <h2 class="h5">
                            Artikelen
                        </h2>

                        <p class="text-muted">
                            Schrijf, bewerk en publiceer kennisbankartikelen.
                        </p>

                        <span class="badge bg-secondary">
                            Binnenkort
                        </span>

                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">

                        <h2 class="h5">
                            Website
                        </h2>

                        <p class="text-muted">
                            Open de publieke website van Airways Orthodontics.
                        </p>

                        <a
                            href="{{ path('home') }}"
                            class="btn btn-outline-secondary"
                            target="_blank"
                        >
                            Website bekijken
                        </a>

                    </div>
                </div>
            </div>

        </div>

    </div>

{% endblock %}