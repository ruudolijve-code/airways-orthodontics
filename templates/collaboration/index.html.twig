{% extends 'base.html.twig' %}

{% block title %}
    Samenwerking | Airways Orthodontics
{% endblock %}

{% block meta_description %}
    Maak kennis met de organisaties en zorgprofessionals die samenwerken binnen Airways Orthodontics.
{% endblock %}

{% block body %}

    {# Hero #}
    <section class="bg-[#f4f5f1] py-20 lg:py-28">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

            <div class="max-w-3xl">

                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">
                    Samenwerking
                </p>

                <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
                    Samen kijken we verder
                    <span class="text-teal-800">
                        dan één discipline.
                    </span>
                </h1>

                <p class="mt-7 text-lg leading-8 text-slate-600">
                    Luchtweg-, ademhalings- en slaapgerelateerde klachten
                    hebben niet altijd één oorzaak. Daarom brengt Airways
                    Orthodontics verschillende disciplines samen.
                </p>

                <p class="mt-4 text-base leading-7 text-slate-600">
                    Afhankelijk van de klachten en bevindingen kunnen
                    orthodontie, kaakchirurgie, airway dentistry,
                    ademfysiologie en andere zorgdisciplines bij de
                    beoordeling en begeleiding worden betrokken.
                </p>

            </div>

        </div>

    </section>


    {# Partners #}
    <section class="bg-white py-20 lg:py-28">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

            <div class="max-w-3xl">

                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">
                    Ons netwerk
                </p>

                <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
                    Samenwerkende organisaties
                </h2>

                <p class="mt-5 text-lg leading-8 text-slate-600">
                    Iedere partner brengt zijn eigen expertise in. Zo ontstaat
                    een bredere beoordeling van de patiënt en kunnen we
                    gerichter bepalen welke vervolgstap passend is.
                </p>

            </div>


            <div class="mt-14 space-y-8">

                {% for partner in partners %}

                    <article class="overflow-hidden rounded-3xl border border-slate-200 bg-white">

                        <div class="grid lg:grid-cols-[0.75fr_1.25fr]">

                            {# Organisatie #}
                            <div class="flex flex-col justify-between bg-[#f4f5f1] p-8 lg:p-10">

                                <div>

                                    <div class="flex min-h-24 items-center">

                                        <img
                                            src="{{ asset(partner.logo) }}"
                                            alt="{{ partner.name }}"
                                            class="max-h-16 max-w-[220px] object-contain object-left"
                                            loading="lazy"
                                        >

                                    </div>

                                    <h3 class="mt-8 text-2xl font-semibold text-slate-950">
                                        {{ partner.name }}
                                    </h3>

                                    <p class="mt-4 text-sm leading-6 text-slate-600">
                                        {{ partner.description }}
                                    </p>

                                </div>

                            </div>


                            {# Professionals #}
                            <div class="p-8 lg:p-10">

                                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-teal-700">
                                    Professionals
                                </p>

                                <div class="mt-6 grid gap-5 sm:grid-cols-2">

                                    {% for professional in partner.professionals %}

                                        <article class="rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-teal-200 hover:shadow-md">

                                            <div class="flex items-start gap-4">

                                                <div class="h-16 w-16 shrink-0 overflow-hidden rounded-full border border-slate-200 bg-slate-100">

                                                    {% if professional.photo is defined and professional.photo %}

                                                        <img
                                                            src="{{ asset(professional.photo) }}"
                                                            alt="{{ professional.name }}"
                                                            class="h-full w-full object-cover"
                                                            loading="lazy"
                                                        >

                                                    {% else %}

                                                        <div class="flex h-full w-full items-center justify-center bg-teal-50 text-base font-semibold text-teal-800">
                                                            {{ professional.name|split(' ')|first|first }}
                                                            {{ professional.name|split(' ')|last|first }}
                                                        </div>

                                                    {% endif %}

                                                </div>

                                                <div class="min-w-0 flex-1">

                                                    <h4 class="text-base font-semibold text-slate-950">
                                                        {{ professional.name }}
                                                    </h4>

                                                    <p class="mt-1 text-sm font-medium text-teal-700">
                                                        {{ professional.function }}
                                                    </p>

                                                    {% if professional.role is defined and professional.role %}
                                                        <p class="mt-3 text-sm leading-6 text-slate-600">
                                                            {{ professional.role }}
                                                        </p>
                                                    {% endif %}

                                                </div>

                                            </div>

            </article>

        {% endfor %}

    </div>

</div>

                        </div>

                    </article>

                {% endfor %}

            </div>

        </div>

    </section>


    {# Waarom multidisciplinair #}
    <section class="bg-teal-950 py-20 text-white lg:py-24">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

            <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-center">

                <div class="max-w-3xl">

                    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-300">
                        Eén patiënt, meerdere perspectieven
                    </p>

                    <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">
                        De klacht bepaalt niet automatisch de behandeling.
                    </h2>

                    <p class="mt-5 text-base leading-7 text-white/70">
                        Door kennis vanuit verschillende disciplines te
                        combineren ontstaat een completer beeld van
                        ademhaling, slaap, luchtweg en kaakontwikkeling.
                        Daarmee kan gerichter worden bepaald welke behandeling
                        of begeleiding daadwerkelijk zinvol is.
                    </p>

                </div>

                <a
                    href="{{path('referral_index')}}"
                    class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3.5 text-sm font-semibold text-teal-950 transition hover:bg-teal-50"
                >
                    Patiënt bespreken

                    <svg
                        viewBox="0 0 20 20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        class="ml-2 h-4 w-4"
                        aria-hidden="true"
                    >
                        <path
                            d="M4 10h12m-5-5 5 5-5 5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </svg>
                </a>

            </div>

        </div>

    </section>

{% endblock %}