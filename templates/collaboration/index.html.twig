{% extends 'base.html.twig' %}

{% block title %}
    Samenwerking | Airways Orthodontics
{% endblock %}

{% block meta_description %}
    Maak kennis met de orthodontisten, kaakchirurgen, tandartsen en ademexperts die samenwerken rond luchtweg, kaakontwikkeling en mondfunctie.
{% endblock %}

{% block body %}

    {# Hero #}
    <section class="relative overflow-hidden bg-[#f4f5f1] py-20 lg:py-28">

        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(13,148,136,.08),transparent_45%)]"></div>

        <div class="relative mx-auto max-w-7xl px-6 lg:px-8">

            <div class="max-w-4xl">

                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">
                    Multidisciplinaire samenwerking
                </p>

                <h1 class="mt-5 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl lg:leading-[1.08]">
                    De juiste expertise
                    <span class="text-teal-800">
                        op het juiste moment.
                    </span>
                </h1>

                <p class="mt-7 max-w-3xl text-lg leading-8 text-slate-600">
                    Goede airway-zorg vraagt om meer dan één discipline.
                    Orthodontisten en kaakchirurgen vormen de kern van de
                    behandeling en werken waar nodig samen met tandheelkundige
                    en functionele experts.
                </p>

                <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">
                    Zo kunnen kaakontwikkeling, gebitsstand, tongfunctie,
                    mondfunctie en ademhaling in samenhang worden beoordeeld,
                    terwijl iedere professional vanuit zijn eigen expertise
                    verantwoordelijk blijft voor zijn deel van het traject.
                </p>

            </div>

        </div>

    </section>


    {# Zorgketen #}
    <section class="border-y border-slate-200 bg-white py-12">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

            <div class="grid gap-6 md:grid-cols-3">

                <div class="rounded-2xl bg-teal-950 p-6 text-white">
                    <span class="text-xs font-semibold uppercase tracking-[0.16em] text-teal-300">
                        Behandeling
                    </span>

                    <h2 class="mt-3 text-lg font-semibold">
                        Orthodontie & kaakchirurgie
                    </h2>

                    <p class="mt-3 text-sm leading-6 text-white/70">
                        Diagnostiek en behandeling van kaakontwikkeling,
                        gebitsstand en, wanneer nodig, chirurgische correctie.
                    </p>
                </div>

                <div class="rounded-2xl border border-slate-200 bg-[#f4f5f1] p-6">
                    <span class="text-xs font-semibold uppercase tracking-[0.16em] text-teal-700">
                        Herkennen & verwijzen
                    </span>

                    <h2 class="mt-3 text-lg font-semibold text-slate-950">
                        Airway dentistry
                    </h2>

                    <p class="mt-3 text-sm leading-6 text-slate-600">
                        Tandheelkundige beoordeling van mondfunctie, tongpositie
                        en gebit, met gerichte verwijzing en waar passend
                        kleinere tandheelkundige ingrepen.
                    </p>
                </div>

                <div class="rounded-2xl border border-slate-200 bg-[#f4f5f1] p-6">
                    <span class="text-xs font-semibold uppercase tracking-[0.16em] text-teal-700">
                        Functie & stabiliteit
                    </span>

                    <h2 class="mt-3 text-lg font-semibold text-slate-950">
                        Ademhaling
                    </h2>

                    <p class="mt-3 text-sm leading-6 text-slate-600">
                        Functionele begeleiding rond neusademhaling en
                        ademhalingspatronen, met bijzondere aandacht voor
                        het behoud van het behandelresultaat.
                    </p>
                </div>

            </div>

        </div>

    </section>


    {# Partners #}
    <section class="bg-white py-20 lg:py-28">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

            <div class="max-w-3xl">

                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">
                    Ons netwerk
                </p>

                <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
                    Samenwerkende professionals
                </h2>

                <p class="mt-5 text-lg leading-8 text-slate-600">
                    Iedere partner heeft een duidelijk afgebakende rol binnen
                    het behandeltraject. Samen ontstaat een breder beeld,
                    zonder dat verantwoordelijkheden tussen disciplines
                    door elkaar lopen.
                </p>

            </div>


            <div class="mt-14 space-y-8">

                {% for partner in partners %}

                    <article class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">

                        <div class="grid lg:grid-cols-[0.72fr_1.28fr]">

                            {# Organisatie #}
                            <div class="flex flex-col justify-between bg-[#f4f5f1] p-8 lg:p-10">

                                <div>

                                    {% if partner.logo is defined and partner.logo %}
                                        <div class="flex min-h-20 items-center">
                                            <img
                                                src="{{ asset(partner.logo) }}"
                                                alt="{{ partner.name }}"
                                                class="max-h-14 max-w-[220px] object-contain object-left"
                                                loading="lazy"
                                            >
                                        </div>
                                    {% endif %}

                                    <h3 class="{{ partner.logo is defined and partner.logo ? 'mt-8' : '' }} text-2xl font-semibold tracking-tight text-slate-950">
                                        {{ partner.name }}
                                    </h3>

                                    <p class="mt-4 text-sm leading-6 text-slate-600">
                                        {{ partner.description }}
                                    </p>

                                </div>

                            </div>


                            {# Professionals #}
                            <div class="p-8 lg:p-10">

                                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-teal-700">
                                    Expertise
                                </p>

                                <div class="mt-6 grid gap-5 {% if partner.professionals|length > 1 %}sm:grid-cols-2{% endif %}">

                                    {% for professional in partner.professionals %}

                                        <article class="rounded-2xl border border-slate-200 bg-white p-5 transition duration-200 hover:border-teal-200 hover:shadow-md">

                                            <div class="flex items-start gap-5">

                                                <div class="h-20 w-20 shrink-0 overflow-hidden rounded-2xl border border-slate-200 bg-slate-100">

                                                    {% if professional.photo is defined and professional.photo %}

                                                        <img
                                                            src="{{ asset(professional.photo) }}"
                                                            alt="{{ professional.name }}"
                                                            class="h-full w-full object-cover"
                                                            loading="lazy"
                                                        >

                                                    {% else %}

                                                        <div class="flex h-full w-full items-center justify-center bg-teal-50 text-lg font-semibold text-teal-800">
                                                            {{ professional.name|split(' ')|first|first }}
                                                            {{ professional.name|split(' ')|last|first }}
                                                        </div>

                                                    {% endif %}

                                                </div>

                                                <div class="min-w-0 flex-1">

                                                    <h4 class="text-base font-semibold text-slate-950">
                                                        {{ professional.name }}
                                                    </h4>

                                                    <p class="mt-1 text-sm font-medium text-teal-700">
                                                        {{ professional.function }}
                                                    </p>

                                                    {% if professional.role is defined and professional.role %}
                                                        <p class="mt-3 text-sm leading-6 text-slate-600">
                                                            {{ professional.role }}
                                                        </p>
                                                    {% endif %}

                                                    {% if professional.BIG is defined and professional.BIG %}
                                                        <p class="mt-3 text-xs text-slate-400">
                                                            BIG {{ professional.BIG }}
                                                        </p>
                                                    {% endif %}

                                                </div>

                                            </div>

                                        </article>

                                    {% endfor %}

                                </div>

                            </div>

                        </div>

                    </article>

                {% endfor %}

            </div>

        </div>

    </section>


    {# Voor verwijzers en toekomstige netwerkpartners #}
    <section id="verwijzers" class="scroll-mt-24 bg-[#eef8f7] py-20 lg:py-24">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

            <div class="overflow-hidden rounded-[2rem] bg-white shadow-sm ring-1 ring-teal-900/10">

                <div class="grid lg:grid-cols-[1.15fr_0.85fr]">

                    <div class="p-8 sm:p-10 lg:p-14">
                        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">
                            Samenwerken als zorgprofessional
                        </p>

                        <h2 class="mt-4 max-w-2xl text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
                            Wilt u bijdragen aan betere multidisciplinaire airway-zorg?
                        </h2>

                        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
                            Sluit aan bij een netwerk waarin tandartsen, fysiotherapeuten, logopedisten en KNO-artsen signalen herkennen, gericht verwijzen en vanuit hun eigen expertise samenwerken rond de patiënt.
                        </p>

                        <a
                            href="{{ path('collaboration_professional_index') }}"
                            class="mt-8 inline-flex items-center rounded-full bg-teal-950 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-teal-900"
                        >
                            Ontdek samenwerken met Airways
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="ml-2 h-4 w-4" aria-hidden="true">
                                <path d="M4 10h12m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    </div>

                    <div class="bg-teal-950 p-8 text-white sm:p-10 lg:p-14">
                        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-teal-300">De gezamenlijke lijn</p>
                        <ol class="mt-7 space-y-5">
                            {% for item in ['Herkennen', 'Diagnostiek', 'Begeleiding of behandeling', 'Samenwerken en gericht verwijzen'] %}
                                <li class="flex items-center gap-4">
                                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/10 text-xs font-semibold text-teal-200">{{ loop.index }}</span>
                                    <span class="font-medium">{{ item }}</span>
                                </li>
                            {% endfor %}
                        </ol>
                    </div>

                </div>

            </div>

        </div>

    </section>


    {# Multidisciplinaire visie #}
    <section class="relative overflow-hidden bg-teal-950 py-20 text-white lg:py-24">

        <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_left,rgba(45,212,191,.12),transparent_45%)]"></div>

        <div class="relative mx-auto max-w-7xl px-6 lg:px-8">

            <div class="grid gap-12 lg:grid-cols-[1fr_auto] lg:items-center">

                <div class="max-w-3xl">

                    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-300">
                        Eén patiënt, meerdere perspectieven
                    </p>

                    <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">
                        Eerst begrijpen wat er speelt. Daarna bepalen welke zorg passend is.
                    </h2>

                    <p class="mt-5 text-base leading-7 text-white/70">
                        Niet iedere ademhalings- of slaapgerelateerde klacht
                        vraagt om orthodontische behandeling. Door expertise
                        vanuit orthodontie, kaakchirurgie, tandheelkunde en
                        ademfysiologie te combineren kan beter worden bepaald
                        welke factoren relevant zijn en welke vervolgstap
                        passend is.
                    </p>

                </div>

                <a
                    href="{{ path('referral_index') }}"
                    class="inline-flex shrink-0 items-center justify-center rounded-full bg-white px-6 py-3.5 text-sm font-semibold text-teal-950 transition hover:bg-teal-50"
                >
                    Patiënt bespreken

                    <svg
                        viewBox="0 0 20 20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        class="ml-2 h-4 w-4"
                        aria-hidden="true"
                    >
                        <path
                            d="M4 10h12m-5-5 5 5-5 5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </svg>
                </a>

            </div>

        </div>

    </section>

{% endblock %}
