<section id="kennismaken" class="scroll-mt-24 bg-teal-950 py-20 text-white lg:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-center">
            <div class="max-w-3xl">
                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-300">Kennismaken</p>
                <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">
                    {% if profession is defined %}Wilt u als {{ profession.name|lower }} aansluiten?{% else %}Ziet u een plek voor uw expertise?{% endif %}
                </h2>
                <p class="mt-5 leading-7 text-white/70">Vertel ons kort over uw praktijk, expertise en regio. We nemen contact op om kennis te maken en samen te onderzoeken of en hoe samenwerking passend is.</p>
            </div>
            <div class="flex flex-wrap gap-3 lg:ml-10">
                <a href="mailto:info@airways-orthodontics.nl?subject=Kennismaking%20Airways-zorgnetwerk{% if profession is defined %}%20-%20{{ profession.name|url_encode }}{% endif %}" class="inline-flex items-center rounded-full bg-white px-6 py-3.5 text-sm font-semibold text-teal-950 transition hover:bg-teal-50">Stuur uw interesse</a>
                <a href="{{ path('contact_index') }}" class="inline-flex items-center rounded-full border border-white/25 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-white/10">Contactgegevens</a>
            </div>
        </div>
    </div>
</section>
