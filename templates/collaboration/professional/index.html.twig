{% extends 'base.html.twig' %}

{% block title %}Zorgprofessional worden | Airways Orthodontics{% endblock %}

{% block meta_description %}Sluit aan bij het multidisciplinaire Airways-zorgnetwerk voor tandartsen, fysiotherapeuten, logopedisten en KNO-artsen.{% endblock %}

{% block body %}
    <section class="relative overflow-hidden bg-[#f4f5f1] py-20 lg:py-28">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(13,148,136,.10),transparent_45%)]"></div>
        <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
            <div class="max-w-4xl">
                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">Airways-zorgnetwerk</p>
                <h1 class="mt-5 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl lg:leading-[1.08]">
                    Samen maken we airway-zorg <span class="text-teal-800">herkenbaar en bereikbaar.</span>
                </h1>
                <p class="mt-7 max-w-3xl text-lg leading-8 text-slate-600">
                    Airways Orthodontics bouwt aan een netwerk waarin zorgprofessionals signalen eerder herkennen, diagnostiek doelgericht inzetten en patiënten begeleiden, behandelen of verwijzen vanuit een gedeelde zorglijn.
                </p>
                <div class="mt-9 flex flex-wrap gap-4">
                    <a href="#disciplines" class="inline-flex items-center rounded-full bg-teal-950 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-teal-900">Bekijk uw discipline</a>
                    <a href="mailto:info@airways-orthodontics.nl?subject=Kennismaking%20Airways-zorgnetwerk" class="inline-flex items-center rounded-full border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-slate-900 transition hover:border-teal-700">Plan een kennismaking</a>
                </div>
            </div>
        </div>
    </section>

    <section class="border-y border-slate-200 bg-white py-12">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
                {% for step in [
                    {number: '01', title: 'Herkennen'},
                    {number: '02', title: 'Onderzoeken'},
                    {number: '03', title: 'Begeleiden'},
                    {number: '04', title: 'Behandelen'},
                    {number: '05', title: 'Gericht verwijzen'}
                ] %}
                    <div class="rounded-2xl bg-[#f8faf9] p-5">
                        <span class="text-xs font-semibold text-teal-700">{{ step.number }}</span>
                        <p class="mt-2 font-semibold text-slate-950">{{ step.title }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section id="disciplines" class="scroll-mt-24 bg-white py-20 lg:py-28">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="max-w-3xl">
                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">Uw plek in het netwerk</p>
                <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">Iedere discipline draagt vanuit de eigen expertise bij.</h2>
                <p class="mt-5 text-lg leading-8 text-slate-600">Kies uw vakgebied en lees hoe herkenning, scholing, samenwerking en verwijzing praktisch kunnen aansluiten op uw dagelijkse werk.</p>
            </div>

            <div class="mt-12 grid gap-6 md:grid-cols-2">
                {% for item in professions %}
                    <a href="{{ path(item.route) }}" class="group rounded-3xl border border-slate-200 bg-white p-8 transition hover:-translate-y-1 hover:border-teal-300 hover:shadow-lg">
                        <div class="flex items-start justify-between gap-6">
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-teal-700">{{ item.eyebrow }}</p>
                                <h3 class="mt-4 text-2xl font-semibold text-slate-950">{{ item.plural }}</h3>
                                <p class="mt-4 leading-7 text-slate-600">{{ item.role }}</p>
                            </div>
                            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-teal-50 text-teal-800 transition group-hover:bg-teal-950 group-hover:text-white">→</span>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="bg-[#eef8f7] py-20 lg:py-24">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
                <div>
                    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">Samenwerken met duidelijke rollen</p>
                    <h2 class="mt-4 text-3xl font-semibold text-slate-950 sm:text-4xl">Eén zorglijn, met ruimte voor ieders professionele verantwoordelijkheid.</h2>
                </div>
                <div class="space-y-4 text-base leading-7 text-slate-600">
                    <p>Niet iedere patiënt heeft dezelfde zorg nodig. Het netwerk helpt om relevante signalen te herkennen en de juiste expertise op het juiste moment te betrekken.</p>
                    <p>Iedere professional blijft verantwoordelijk voor het eigen onderzoek, advies en handelen. Heldere verwijslijnen en terugkoppeling zorgen voor samenhang zonder rollen te vermengen.</p>
                </div>
            </div>
        </div>
    </section>

    {% include 'collaboration/professional/_cta.html.twig' %}
{% endblock %}
