{% extends 'base.html.twig' %}

{% block title %}Samenwerken als {{ profession.name|lower }} | Airways Orthodontics{% endblock %}

{% block meta_description %}Ontdek uw rol als {{ profession.name|lower }} binnen het multidisciplinaire Airways-zorgnetwerk: signaleren, samenwerken en gericht verwijzen.{% endblock %}

{% block body %}
    <section class="relative overflow-hidden bg-[#f4f5f1] py-16 lg:py-24">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(13,148,136,.10),transparent_45%)]"></div>
        <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
            <nav aria-label="Kruimelpad" class="text-sm text-slate-500">
                <a href="{{ path('collaboration_index') }}" class="hover:text-teal-800">Samenwerking</a>
                <span class="mx-2">/</span>
                <a href="{{ path('collaboration_professional_index') }}" class="hover:text-teal-800">Zorgprofessional worden</a>
                <span class="mx-2">/</span>
                <span class="text-slate-700">{{ profession.name }}</span>
            </nav>

            <div class="mt-12 grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
                <div>
                    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">{{ profession.eyebrow }}</p>
                    <h1 class="mt-5 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl lg:leading-[1.08]">{{ profession.headline }}</h1>
                    <p class="mt-7 max-w-3xl text-lg leading-8 text-slate-600">{{ profession.intro }}</p>
                </div>
                <div class="rounded-3xl bg-teal-950 p-8 text-white">
                    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-teal-300">Uw rol</p>
                    <p class="mt-4 leading-7 text-white/75">{{ profession.role }}</p>
                    <a href="#kennismaken" class="mt-7 inline-flex items-center rounded-full bg-white px-5 py-3 text-sm font-semibold text-teal-950 transition hover:bg-teal-50">Ik heb interesse</a>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-white py-20 lg:py-24">
        <div class="mx-auto grid max-w-7xl gap-14 px-6 lg:grid-cols-2 lg:px-8">
            <div>
                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">Herkenning in de praktijk</p>
                <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-950">Signalen die aanleiding kunnen geven tot verder kijken.</h2>
                <p class="mt-5 leading-7 text-slate-600">Een signaal op zichzelf is geen diagnose. De combinatie, context en professionele beoordeling bepalen of afstemming of verwijzing passend is.</p>
            </div>
            <ul class="grid gap-4 sm:grid-cols-2">
                {% for signal in profession.signals %}
                    <li class="rounded-2xl border border-slate-200 bg-[#f8faf9] p-5">
                        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-teal-100 text-sm font-semibold text-teal-800">✓</span>
                        <p class="mt-4 text-sm font-medium leading-6 text-slate-800">{{ signal }}</p>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>

    <section class="bg-[#eef8f7] py-20 lg:py-24">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
                <div>
                    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">Uw bijdrage</p>
                    <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-950">Van observatie naar afgestemde zorg.</h2>
                </div>
                <div class="grid gap-5 sm:grid-cols-2">
                    {% for contribution in profession.contributions %}
                        <article class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-teal-900/5">
                            <span class="text-xs font-semibold text-teal-700">0{{ loop.index }}</span>
                            <p class="mt-3 font-semibold leading-6 text-slate-950">{{ contribution }}</p>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>

    <section class="bg-white py-20 lg:py-24">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="rounded-[2rem] border border-slate-200 p-8 sm:p-10 lg:flex lg:items-center lg:justify-between lg:p-12">
                <div class="max-w-3xl">
                    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">Scholing & samenwerking</p>
                    <h2 class="mt-4 text-3xl font-semibold text-slate-950">Een gedeelde basis voor beter samenspel.</h2>
                    <p class="mt-5 text-lg leading-8 text-slate-600">{{ profession.education }}</p>
                </div>
                <a href="mailto:info@airways-orthodontics.nl?subject=Interesse%20Airways-netwerk%20-%20{{ profession.name|url_encode }}" class="mt-8 inline-flex shrink-0 items-center rounded-full border border-teal-800 px-6 py-3.5 text-sm font-semibold text-teal-950 transition hover:bg-teal-50 lg:ml-10 lg:mt-0">Vraag informatie aan</a>
            </div>
        </div>
    </section>

    <section class="border-t border-slate-200 bg-[#f8faf9] py-16">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <p class="text-sm font-semibold text-slate-500">Bekijk ook de andere disciplines</p>
            <div class="mt-5 flex flex-wrap gap-3">
                {% for item in professions %}
                    {% if item.slug != profession.slug %}
                        <a href="{{ path(item.route) }}" class="rounded-full border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-800 transition hover:border-teal-600 hover:text-teal-800">{{ item.plural }}</a>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </section>

    {% include 'collaboration/professional/_cta.html.twig' with {profession: profession} %}
{% endblock %}
