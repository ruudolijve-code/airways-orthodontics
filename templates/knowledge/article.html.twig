{% extends 'base.html.twig' %}

{% block title %}
    {{ article.seoTitle ?: article.title }} | Airways Orthodontics
{% endblock %}

{% block meta_description %}
    {{ article.metaDescription
        ?: article.excerpt
        ?: article.intro
        ?: 'Lees meer over ' ~ article.title ~ ' binnen de kennisbank van Airways Orthodontics.'
    }}
{% endblock %}

{% block body %}

<section class="relative overflow-hidden bg-gradient-to-br from-teal-950 via-teal-900 to-slate-900 text-white">

    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(255,255,255,.08),transparent_55%)]"></div>

    <div class="relative mx-auto max-w-7xl px-6 py-16 lg:px-8 lg:py-24">

        <nav class="flex flex-wrap items-center gap-2 text-sm text-teal-200">

            <a
                href="{{ path('knowledge_index') }}"
                class="transition hover:text-white"
            >
                Kennisbank
            </a>

            <span aria-hidden="true">/</span>

            <a
                href="{{ path('knowledge_category_show', {
                    slug: category.slug
                }) }}"
                class="transition hover:text-white"
            >
                {{ category.name }}
            </a>

        </nav>

        <div class="mt-10 max-w-4xl">

            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-teal-300">
                {{ category.name }}
            </p>

            <h1 class="mt-5 text-4xl font-semibold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
                {{ article.title }}
            </h1>

            {% if article.intro %}
                <p class="mt-8 max-w-3xl text-xl leading-9 text-slate-200">
                    {{ article.intro }}
                </p>
            {% elseif article.excerpt %}
                <p class="mt-8 max-w-3xl text-xl leading-9 text-slate-200">
                    {{ article.excerpt }}
                </p>
            {% endif %}

            <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-slate-300">

                {% if article.author %}
                    <span>
                        {{ article.author }}
                    </span>
                {% endif %}

                {% if article.publishedAt %}
                    <time datetime="{{ article.publishedAt|date('Y-m-d') }}">
                        {{ article.publishedAt|date('d-m-Y') }}
                    </time>
                {% endif %}

                {% if article.readingTime %}
                    <span>
                        {{ article.readingTime }} min. leestijd
                    </span>
                {% endif %}

            </div>

        </div>

    </div>

</section>


<main class="bg-white py-16 lg:py-24">

    <div class="mx-auto max-w-7xl px-6 lg:px-8">

        <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-20">

            <article class="min-w-0">

                {% if article.featuredImage %}

                    <figure class="mb-12 overflow-hidden rounded-3xl">

                        <img
                            src="{{ asset(
                                'uploads/knowledge/images/'
                                ~ article.featuredImage.filename
                            ) }}"
                            alt="{{ article.featuredImage.alt ?: article.title }}"
                            class="aspect-[16/9] w-full object-cover"
                        >

                        {% if article.featuredImage.caption %}
                            <figcaption class="mt-3 text-sm leading-6 text-slate-500">
                                {{ article.featuredImage.caption }}
                            </figcaption>
                        {% endif %}

                    </figure>

                {% endif %}


                <div class="prose prose-lg max-w-none prose-slate
                            prose-headings:font-semibold
                            prose-headings:tracking-tight
                            prose-h2:mt-12
                            prose-h2:text-3xl
                            prose-h3:mt-9
                            prose-h3:text-2xl
                            prose-a:text-teal-700
                            prose-a:no-underline
                            hover:prose-a:text-teal-900
                            prose-blockquote:border-teal-700
                            prose-blockquote:text-slate-700">

                    {{ article.content|raw }}

                </div>

            </article>


            <aside class="lg:sticky lg:top-28 lg:self-start">

                <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6">

                    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-teal-700">
                        Onderwerp
                    </p>

                    <p class="mt-3 text-lg font-semibold text-slate-950">
                        {{ category.name }}
                    </p>

                    {% if category.description %}
                        <p class="mt-3 text-sm leading-6 text-slate-600">
                            {{ category.description }}
                        </p>
                    {% endif %}

                    <a
                        href="{{ path('knowledge_category_show', {
                            slug: category.slug
                        }) }}"
                        class="mt-6 inline-flex items-center font-semibold text-teal-700 transition hover:text-teal-900"
                    >
                        Meer artikelen

                        <svg
                            viewBox="0 0 20 20"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            class="ml-2 h-4 w-4"
                            aria-hidden="true"
                        >
                            <path
                                d="M4 10h12m-5-5 5 5-5 5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                    </a>

                </div>

            </aside>

        </div>

    </div>

</main>


<section class="bg-slate-50 py-16">

    <div class="mx-auto max-w-7xl px-6 lg:px-8">

        <a
            href="{{ path('knowledge_category_show', {
                slug: category.slug
            }) }}"
            class="inline-flex items-center gap-2 font-semibold text-teal-700 transition hover:text-teal-900"
        >
            <svg
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                class="h-4 w-4"
                aria-hidden="true"
            >
                <path
                    d="M12.5 4.5 7 10l5.5 5.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                />
            </svg>

            Terug naar {{ category.name }}
        </a>

    </div>

</section>

{% endblock %}